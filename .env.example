# =============================================================
#  .env.example — Starlight Express environment template
# =============================================================
#
#  Copy this file to .env and fill in real values before
#  running docker-compose up.
#
#    cp .env.example .env
#
#  !! NEVER commit .env to version control !!
#  (It is already listed in .gitignore and .dockerignore)
# =============================================================


# ── reCAPTCHA v3 ─────────────────────────────────────────────
# Register your domain at https://www.google.com/recaptcha/admin
# Choose "reCAPTCHA v3", add localhost + your production domain.
#
RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_v3_secret_key_here


# ── SMTP / Mail ───────────────────────────────────────────────
# Dev default: routes through Mailhog (no auth, no TLS).
# View caught emails at http://localhost:8025
#
# For production, change these to your real SMTP relay and
# set SMTP_USER + SMTP_PASS — the entrypoint will enable TLS
# automatically when SMTP_USER is present.
#
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=noreply@starlight.com.np
#SMTP_USER=smtp_username
#SMTP_PASS=smtp_password
