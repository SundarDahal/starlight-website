Options -Indexes
ServerSignature Off

# Block Windows Zone.Identifier alternate-data-stream stubs (WSL artefacts)
<FilesMatch "\.Zone\.Identifier$">
    Require all denied
</FilesMatch>

# Protect server/config files from direct access
<FilesMatch "^(\.htaccess|\.env.*|composer\.(json|lock)|package(-lock)?\.json)$">
    Require all denied
</FilesMatch>

RewriteEngine On

# Force HTTPS (skip on localhost so Docker dev works over plain HTTP)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Rewrite clean URLs -> .html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(about|contact|offices|privacy|services|track)$ $1.html [L]

# Basic hardening
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>